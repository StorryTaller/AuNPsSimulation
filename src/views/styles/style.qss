QWidget {
    background: @APP_BG@;
    color: @TEXT@;
    font-family: "Arial", "DengXian", "等线", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background: @APP_BG@;
}

QLabel {
    background: transparent;
}

QFrame#NavPanel {
    background: @CARD_BG@;
    border-right: 1px solid @BORDER@;
}

QFrame#TopBar {
    background: @CARD_BG@;
    border-bottom: 1px solid @BORDER@;
}

QPushButton#NavButton {
    border: none;
    text-align: left;
    padding: 10px 12px;
    border-radius: 8px;
    color: @TEXT@;
    background: transparent;
}

QPushButton#NavButton:hover {
    background: rgba(0, 120, 212, 0.10);
}

QPushButton#NavButton:checked {
    background: rgba(0, 120, 212, 0.16);
    color: @PRIMARY@;
    font-weight: 600;
}

QFrame#PageCard {
    background: @CARD_BG@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QGroupBox {
    background: @CARD_BG@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    margin-top: 12px;
    padding: 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    top: 2px;
    color: @TEXT_SUB@;
    font-size: 12px;
    font-weight: 600;
    background: @CARD_BG@;
    padding: 0 4px;
}

QPushButton {
    background: @PRIMARY@;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 5px 12px;
    font-family: "Arial", "DengXian", "等线", sans-serif;
    font-size: 13px;
    font-weight: 700;
}

QPushButton:hover {
    background: @PRIMARY_HOVER@;
}

QPushButton:disabled {
    background: #9FB7CC;
    color: #EEF4FA;
}

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
    background: @CARD_BG@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT@;
    selection-background-color: @PRIMARY@;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid @PRIMARY@;
}

QToolButton#ParamStepButton {
    background: @CARD_BG@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 0;
}

QToolButton#ParamStepButton:hover {
    border: 1px solid @PRIMARY@;
    color: @PRIMARY@;
}

QToolButton#ParamStepButton:pressed {
    background: rgba(0, 120, 212, 0.08);
}

QToolButton#ParamStepButton:disabled {
    color: #9FB7CC;
    border: 1px solid @BORDER@;
}

QLineEdit[readOnly="true"] {
    background: #F7FAFD;
    color: @TEXT@;
}

QListWidget {
    background: transparent;
    border: 1px solid #000000;
    border-radius: 0;
    padding: 2px;
    color: @TEXT@;
}

QListWidget:focus {
    border: 1px solid #000000;
}

QListWidget::item {
    background: transparent;
    border: none;
    color: @TEXT@;
    padding: 0 6px;
    margin: 0;
}

QListWidget::item:selected {
    background: transparent;
    color: @TEXT@;
    border: none;
}

QListWidget::item:hover {
    background: transparent;
}

QListWidget#MultiParamList {
    background: #F7FAFD;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 6px;
    color: @TEXT@;
}

QListWidget#MultiParamList:focus {
    border: 1px solid @PRIMARY@;
}

QListWidget#MultiParamList::item {
    border: none;
    padding: 0;
    margin: 2px 0;
}

QWidget#ParamRow {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
}

QWidget#ParamRow:hover {
    background: transparent;
    border: 1px solid transparent;
}

QCheckBox#ParamCheckbox {
    color: @TEXT@;
    border: 1px solid @BORDER@;
    background: #F7FAFD;
    border-radius: 8px;
    spacing: 10px;
    padding: 6px 10px;
    font-size: 13px;
}

QCheckBox#ParamCheckbox:hover {
    border: 1px solid rgba(0, 120, 212, 0.36);
    background: #F3F8FE;
}

QCheckBox#ParamCheckbox:checked {
    font-weight: 600;
    border: 1px solid rgba(0, 120, 212, 0.45);
    background: rgba(0, 120, 212, 0.08);
}

QCheckBox#ParamCheckbox::indicator {
    width: 16px;
    height: 16px;
    margin-right: 4px;
}

QLabel[class="subtitle"] {
    color: @TEXT_SUB@;
}
